{
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make smoke)",
      "Bash(make test-gpu)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(rm -rf workspace:*)",
      "Read(./.env)",
      "Read(./workspace/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block_real_flight.py" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && (uv run ruff format --quiet src tests flight 2>/dev/null || true)" }
        ]
      }
    ]
  }
}
