@@ -83,6 +83,20 @@ inline __device__ void covarW2C_VJP(
 // Reduce
 ///////////////////////////////
 
+// drone-scan Pascal patch (docker/patches/gsplat-v1.5.3-pascal.patch):
+// cg::labeled_partition needs match collectives (sm_70+). Below sm_70 every thread forms
+// its own group of size 1, so warpSum is a no-op and each thread adds its gradients with
+// atomicAdd itself (same sum, different summation order). sm_70+ keeps the original path.
+template <class TileT, class LabelT>
+inline __device__ auto labeled_partition_compat(const TileT &tile, LabelT label) {
+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ < 700
+    (void)label;
+    return cg::tiled_partition<1>(tile);
+#else
+    return cg::labeled_partition(tile, label);
+#endif
+}
